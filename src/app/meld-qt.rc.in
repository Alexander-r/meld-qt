// The Windows program's icon and version information, configured by CMake
// (qmake writes its own from RC_ICONS and VERSION in app.pro)

#include <winver.h>

IDI_ICON1 ICON "@meld_rc_icon@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Meld Qt\0"
            VALUE "FileDescription", "Meld Qt - @PROJECT_DESCRIPTION@\0"
            VALUE "FileVersion", "@meld_version@\0"
            VALUE "InternalName", "meld-qt\0"
            VALUE "LegalCopyright", "@meld_rc_copyright@\0"
            VALUE "OriginalFilename", "meld-qt.exe\0"
            VALUE "ProductName", "Meld Qt\0"
            VALUE "ProductVersion", "@meld_version@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
